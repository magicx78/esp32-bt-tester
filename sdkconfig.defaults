# ---- Target ----
CONFIG_IDF_TARGET="esp32"

# ---- Flash / Partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Bluetooth: Dual-Mode (Classic BR/EDR + BLE), Bluedroid host ----
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=n

# Classic BT Secure Simple Pairing (needed for Just Works)
CONFIG_BT_SSP_ENABLED=y

# BLE (für Scan/Observer)
CONFIG_BT_BLE_ENABLED=y
# GATT client/server werden nicht gebraucht (nur Scannen)
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=n

# ---- WiFi + Bluetooth Koexistenz (ein Funk-Core) ----
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ---- HTTP Server ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# ---- IRAM-Entlastung (Dual-Mode-BT + WLAN ohne PSRAM) ----
# WLAN-Routinen aus dem IRAM ins Flash verlagern -> schafft ~30 KB IRAM
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# ---- PSRAM ----
# Für ESP32-WROVER (mit PSRAM) die folgenden Zeilen aktivieren:
# CONFIG_SPIRAM=y
# CONFIG_SPIRAM_USE_MALLOC=y
